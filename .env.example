# TRINEX local configuration reference
# This file is a template only. It is NOT loaded automatically by Flutter or Cloudflare Workers.
# Never put real secrets in this file.

# -----------------------------------------------------------------------------
# Flutter / client build
# -----------------------------------------------------------------------------
# Used with: flutter build ... --dart-define=ASSOCIATION_API_BASE_URL=...
ASSOCIATION_API_BASE_URL=https://YOUR-API-DOMAIN.example.com

# -----------------------------------------------------------------------------
# Backend public configuration (mirrors backend/wrangler.toml [vars])
# -----------------------------------------------------------------------------
APP_VERSION=2.0.1
MINIMUM_APP_VERSION=2.0.0
APP_UPDATE_URL=
APP_RELEASE_NOTES=
API_VERSION=v1
ALLOWED_ORIGINS=https://YOUR-WEBSITE-DOMAIN.example.com
# Production Apps Script URLs are injected by GitHub Actions from GitHub Secrets.
# Keep placeholders here for local configuration reference only.
GOOGLE_APPS_SCRIPT_DRIVE_URL=
GOOGLE_APPS_SCRIPT_GMAIL_URL=

EINO_TEXT_MODEL=auto
EINO_STUDENT_DAILY_LIMIT=100
EINO_GUEST_DAILY_LIMIT=20
EINO_GLOBAL_DAILY_LIMIT=2000
EINO_MISTRAL_BASE_URL=https://api.mistral.ai
EINO_GROQ_BASE_URL=https://api.groq.com/openai/v1
EINO_MISTRAL_TEXT_MODEL=mistral-small-2603
EINO_MISTRAL_VISION_MODEL=mistral-small-2603
EINO_MISTRAL_OCR_MODEL=mistral-ocr-latest
EINO_MISTRAL_STT_MODEL=voxtral-mini-2602
EINO_MISTRAL_TTS_MODEL=voxtral-mini-tts-2603
EINO_GROQ_TEXT_MODEL=openai/gpt-oss-120b
EINO_GROQ_VISION_MODEL=qwen/qwen3.8-27b
EINO_GROQ_STT_MODEL=whisper-large-v3-turbo
EINO_GROQ_TTS_MODEL=canopylabs/orpheus-arabic-saudi
EINO_EMBEDDING_BASE_URL=
EINO_EMBEDDING_MODEL=
EINO_MODEL_CATALOG_JSON=
CHROMA_BASE_URL=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_COLLECTION_ID=

# -----------------------------------------------------------------------------
# Backend secrets — placeholders only; use Cloudflare Secrets / GitHub Secrets.
# -----------------------------------------------------------------------------
FREE_AI_API_KEY=
FREE_AI_BASE_URL=
MISTRAL_API_KEY=
GROQ_API_KEY=
EINO_EMBEDDING_API_KEY=
GOOGLE_APPS_SCRIPT_DRIVE_TOKEN=
STAFF_BOOTSTRAP_TOKEN=

# -----------------------------------------------------------------------------
# Google Apps Script local reference
# The deployed script expects these as Script Properties, not as repository files.
# -----------------------------------------------------------------------------
ROOT_FOLDER_ID=
API_TOKEN=

# -----------------------------------------------------------------------------
# GitHub Actions production variables/secrets are documented in docs/CONFIGURATION.md.
# They intentionally are not copied here because this file is for application/runtime
# configuration, not GitHub account credentials or Android signing material.
# -----------------------------------------------------------------------------

# Student password recovery email (Google Apps Script + Gmail)

GOOGLE_APPS_SCRIPT_GMAIL_TOKEN=
